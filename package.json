{
  "name": "fujisan-lanka-erp",
  "version": "1.0.0",
  "description": "Hummingbird Clothing ERP - Complete Desktop ERP System for FujiSan Lanka Pvt Ltd",
  "main": "main.js",
  "author": {
    "name": "FujiSan Lanka Pvt Ltd",
    "email": "info@fujisanlanka.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_IS_DEV=1 electron .",
    "dev:win": "set ELECTRON_IS_DEV=1 && electron .",
    "build": "electron-builder build --publish never",
    "build:win": "electron-builder build --win --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:linux": "electron-builder build --linux --publish never",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.fujisanlanka.hummingbird-erp",
    "productName": "Hummingbird Clothing ERP",
    "copyright": "Copyright © 2024 FujiSan Lanka Pvt Ltd",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "modules/**/*",
      "data/**/*",
      "utils/**/*",
      "systems/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/images/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hummingbird ERP",
      "installerIcon": "assets/images/icon.ico",
      "uninstallerIcon": "assets/images/icon.ico",
      "installerHeaderIcon": "assets/images/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/images/icon.icns",
      "category": "public.app-category.business",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Hummingbird Clothing ERP",
      "icon": "assets/images/icon.icns",
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/images/icons/",
      "category": "Office",
      "description": "Hummingbird Clothing ERP System"
    },
    "publish": null
  },
  "keywords": [
    "erp",
    "clothing",
    "manufacturing",
    "electron",
    "desktop",
    "offline",
    "inventory",
    "production"
  ]
}
